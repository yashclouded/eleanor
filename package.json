{
  "name": "eleanor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && deno check supabase/functions/api/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:db": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "content:check": "tsx scripts/content-check.ts",
    "content:preview": "tsx scripts/content-preview.ts",
    "content:sync": "tsx scripts/content-sync.ts",
    "model:simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "6.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.25.0",
    "@playwright/test": "1.50.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.25.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "15.15.0",
    "postgres": "^3.4.9",
    "supabase": "2.119.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
